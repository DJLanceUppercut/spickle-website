{
  "framework": "astro",
  "buildCommand": "astro build",
  "installCommand": "npm install",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/home",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/pages/cookie-policy",
      "destination": "/privacy",
      "permanent": true
    }
  ]
}
