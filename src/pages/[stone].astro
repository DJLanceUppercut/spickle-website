---
import Base from '../layouts/Base.astro';
import { stones } from '../data/stones.js';

export function getStaticPaths() {
  return stones.map((s) => ({ params: { stone: s.slug }, props: { s } }));
}

const { s } = Astro.props;
const others = stones.filter((o) => o.slug !== s.slug);
---
<Base
  title={`${s.name} Cleaning & Sealing Melbourne | Spickle`}
  description={`${s.name} cleaning and sealing across Melbourne and the Mornington Peninsula. From $16/m². Book a quote.`}
>
  <!-- Stone hero -->
  <section class="band stone-hero hairline-top">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="crumb"><a href="/#stones">Stones we work with</a></p>
        <h1>{s.name}</h1>
        <p class="lede">{s.tagline}</p>
        <div class="cta-row">
          <a class="btn btn-primary" href="/book-now">Book a quote</a>
          <a class="tlink" href="tel:1300220045">Call 1300 22 00 45</a>
        </div>
      </div>
      <img class="hero-img" src={s.image} alt={`${s.name} surface`} width="900" height="700" />
    </div>
  </section>

  <!-- About -->
  <section class="band panel">
    <div class="wrap about-grid">
      <div>
        <h2>About the stone</h2>
        <p>{s.what}</p>
      </div>
      <div>
        <h2>What goes wrong</h2>
        <ul class="risks">
          {s.risks.map((r) => <li>{r}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <!-- Treatment -->
  <section class="band">
    <div class="wrap treat-grid">
      <h2>How we treat it</h2>
      <div>
        <p>{s.treatment}</p>
        <p class="price-line">Cleaning and sealing runs from <strong>$16 to $40 per m²</strong>, depending on the sealer and what the job needs. Rural jobs carry a separate travel fee, quoted up front.</p>
      </div>
    </div>
  </section>

  <!-- Photos -->
  <section class="band hairline-top">
    <div class="wrap">
      <h2>{s.name} jobs</h2>
      <div class="todo">[Before and after photos of real Spickle {s.name.toLowerCase()} jobs go here. Waiting on job photos from Lukey.]</div>
    </div>
  </section>

  <!-- Book -->
  <section class="band panel">
    <div class="wrap book-row">
      <div>
        <h2>Book a {s.name.toLowerCase()} quote</h2>
        <p>Send a few photos and the rough size of the area, and we'll come back with a price.</p>
      </div>
      <div class="cta-row">
        <a class="btn btn-primary" href="/book-now">Book a quote</a>
        <a class="tlink" href="tel:1300220045">Call 1300 22 00 45</a>
      </div>
    </div>
  </section>

  <!-- Other stones -->
  <section class="band">
    <div class="wrap">
      <h2 class="other-head">Other stones we work with</h2>
      <ul class="other-stones">
        {others.map((o) => <li><a href={`/${o.slug}`}>{o.name}</a></li>)}
      </ul>
    </div>
  </section>
</Base>

<style>
  .hero-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(400px, 100%), 1fr)); gap: clamp(2rem, 5vw, 5rem); align-items: center; }
  .crumb { font-size: var(--step--1); margin-bottom: 1rem; }
  .crumb a { color: var(--faint); text-decoration: none; }
  .crumb a:hover { color: var(--white); text-decoration: underline; }
  .hero-copy h1 { margin-bottom: 0.4em; }
  .lede { font-size: var(--step-1); line-height: 1.45; color: #d6e8ee; max-width: 30ch; }
  .cta-row { display: flex; flex-wrap: wrap; align-items: center; gap: 0.9rem 1.6rem; margin-top: 1.4rem; }
  .hero-img { width: 100%; height: clamp(300px, 36vw, 520px); object-fit: cover; border-radius: 2px; }

  .about-grid, .treat-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(400px, 100%), 1fr)); gap: clamp(2rem, 5vw, 5rem); align-items: start; }
  .risks { margin: 0; padding: 0; list-style: none; max-width: var(--measure); }
  .risks li { padding: 0.8rem 0; border-top: 1px solid var(--hairline); color: var(--muted); }
  .risks li:last-child { border-bottom: 1px solid var(--hairline); }
  .treat-grid h2 { margin: 0; }
  .price-line { padding-top: 1.2rem; border-top: 1px solid var(--hairline); }
  .price-line strong { color: var(--white); }

  .book-row { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 1.5rem 3rem; }
  .book-row h2 { margin-bottom: 0.3em; }
  .book-row p { margin: 0; }

  .other-head { font-size: var(--step-1); }
  .other-stones { margin: 0; padding: 0; list-style: none; display: flex; flex-wrap: wrap; gap: 0.75rem 1rem; }
  .other-stones a {
    display: inline-flex; padding: 0.55rem 1rem; border: 1px solid var(--hairline); border-radius: 2px;
    color: var(--muted); text-decoration: none; font-size: 1rem; font-weight: 600;
  }
  .other-stones a:hover { color: var(--white); border-color: var(--teal); }
</style>
