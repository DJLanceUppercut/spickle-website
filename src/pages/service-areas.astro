---
import { BOOKING_URL } from '../config/site.js';
import Base from '../layouts/Base.astro';
import { regions } from '../data/serviceAreas.js';
import { suburbs } from '../data/suburbs.js';
---
<Base
  title="Service Areas: Melbourne & Mornington Peninsula | Spickle"
  description="Spickle cleans and seals stone and concrete across all of Melbourne and the Mornington Peninsula. See the suburbs we work in, including Hawthorn, Toorak and Sorrento."
>
  <section class="band hairline-top">
    <div class="wrap">
      <h1>Where we work</h1>
      <p class="lede">We clean and seal stone and concrete across all of Melbourne and the Mornington Peninsula. Suburbs we work in include:</p>
      <div class="regions">
        {regions.map((r) => (
          <div>
            <h2>{r.name}</h2>
            <ul class="burbs">
              {r.suburbs.map((n) => <li>{n}</li>)}
            </ul>
          </div>
        ))}
      </div>
      {suburbs.length > 0 && (
        <p class="local">Local pages: {suburbs.map((sub, i) => <>{i > 0 && ', '}<a class="tlink" href={`/${sub.slug}`}>{sub.name}</a></>)}</p>
      )}
      <p class="rural">Don't see your suburb? We'll still come to you. Rural jobs carry a separate travel fee, quoted up front, so you'll know the full price before you book.</p>
    </div>
  </section>

  <section class="band panel">
    <div class="wrap book-row">
      <div>
        <h2>In the area?</h2>
        <p>Send photos and a rough size and we'll price your job.</p>
      </div>
      <div class="cta-row">
        <a class="btn btn-primary" href={BOOKING_URL}>Book a quote</a>
        <a class="tlink" href="tel:1300220045">Call 1300 22 00 45</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .lede { font-size: var(--step-1); color: var(--lede); margin-bottom: clamp(2rem, 4vw, 3rem); max-width: 40ch; }
  .regions { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr)); gap: clamp(1.75rem, 3vw, 2.75rem); }
  .regions h2 { font-size: var(--step-1); }
  .burbs { list-style: none; margin: 0; padding: 0; columns: 2 10rem; column-gap: 1.5rem; }
  .burbs li { padding: 0.28rem 0; color: var(--muted); break-inside: avoid; font-size: 1rem; }
  .local { margin-top: 1.5rem; }
  .rural { margin-top: clamp(2rem, 4vw, 3rem); padding-top: 1.4rem; border-top: 1px solid var(--hairline); }
  .book-row { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 1.5rem 3rem; }
  .book-row h2 { margin-bottom: 0.3em; }
  .book-row p { margin: 0; }
  .cta-row { display: flex; flex-wrap: wrap; align-items: center; gap: 0.9rem 1.6rem; }
</style>
