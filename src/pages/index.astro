---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import SealDemo from '../components/SealDemo.astro';
import StoneTexture from '../components/StoneTexture.astro';
import { stones } from '../data/stones.js';
import heroDusk from '../assets/hero-dusk.jpg';
import { pairs } from '../data/gallery.js';
import BeforeAfter from '../components/BeforeAfter.astro';
---
<Base
  title="Stone Cleaning & Sealing Melbourne | Spickle"
  description="Cleaning and sealing for bluestone, limestone, travertine, concrete and more across Melbourne and the Mornington Peninsula. From $15/m². Book a quote."
>
  <!-- Hero -->
  <section class="hero">
    <Image class="hero-bg" src={heroDusk} alt="" widths={[768, 1280, 1920]} sizes="100vw" loading="eager" fetchpriority="high" />
    <div class="hero-shade" aria-hidden="true"></div>
    <div class="wrap hero-inner">
      <div class="hero-copy">
        <h1>Natural stone, sealed properly.</h1>
        <p class="lede">Cleaning and sealing for bluestone, limestone, travertine and every other natural stone, across Melbourne and the Mornington Peninsula.</p>
        <div class="cta-row">
          <a class="btn btn-primary" href="/book-now">Book a quote</a>
          <a class="tlink" href="tel:1300220045">Call 1300 22 00 45</a>
        </div>
        <p class="rating"><span class="stars" aria-hidden="true">★★★★★</span> <span class="todo-inline">[rating] from [number] Google reviews</span></p>
      </div>
      <dl class="facts">
        <div><dt>From $15/m²</dt><dd>cleaning and sealing</dd></div>
        <div><dt>Two sealer types</dt><dd>penetrating and topical</dd></div>
        <div><dt>115 suburbs</dt><dd>Melbourne and the Peninsula</dd></div>
      </dl>
    </div>
  </section>

  <!-- New paving -->
  <section class="band hairline-top" id="new-paving">
    <div class="wrap split">
      <h2 data-reveal>New stone has no protection the day it's laid.</h2>
      <div class="split-copy" data-reveal style="--delay:0.12s">
        <p>Oil, red wine, leaves and barbecue fat soak straight in. Once a stain is inside the stone it's slow and costly to draw out, and some never fully come back.</p>
        <p>Sealing soon after installation, once the stone and grout have cured, keeps it looking the way it did at handover. <a class="tlink" href="/new-installation-sealing">Read about new installation sealing</a></p>
        <aside class="trade">
          <h3>Landscapers and builders</h3>
          <p>We seal your jobs before handover, so your client gets a finished result and you don't get the call about the first stain.</p>
          <a class="tlink" href="tel:1300220045">Set up handover sealing</a>
        </aside>
      </div>
    </div>
  </section>

  <!-- Sealing -->
  <section class="band panel" id="sealing">
    <div class="wrap">
      <h2 data-reveal>Two ways to seal stone</h2>
      <p class="section-lede" data-reveal style="--delay:0.08s">Drag across the paver. Same water, same stone: the only difference is the sealer. We choose the sealer for the stone and where it's laid, then tell you why.</p>
      <div class="seal-grid" data-reveal style="--delay:0.16s">
        <SealDemo />
        <div class="seal-types">
          <div>
            <h3>Penetrating sealer</h3>
            <p>Soaks into the stone and protects it from within. The surface keeps its natural look and its slip resistance, so it's what we use on most outdoor areas.</p>
          </div>
          <div>
            <h3>Topical sealer</h3>
            <p>Sits on the surface as a thin film and gives the stone a matte, satin or gloss finish.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Stones -->
  <section class="band" id="stones">
    <div class="wrap">
      <div class="row-head" data-reveal>
        <h2>Stones we work with</h2>
        <p>Each stone takes cleaners and sealers differently. A cleaner that's safe on granite can etch limestone, so we match the treatment to the stone. Pick yours to see how we treat it.</p>
      </div>
      <ul class="stone-grid">
        {stones.map((s, i) => (
          <li data-reveal style={`--delay:${(i % 4) * 0.07}s`}>
            <a href={`/${s.slug}`}>
              <Image src={s.image} alt="" widths={[320, 640]} sizes="(max-width: 700px) 46vw, 300px" loading="lazy" />
              <span class="stone-info">
                <span class="stone-name">{s.name}</span>
                <span class="stone-tag">{s.tagline}</span>
              </span>
              <span class="stone-arrow" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ul>
      <div class="also" data-reveal>
        <p>We also clean and seal marble, porcelain and terracotta.</p>
        <p class="also-links">By area: <a class="tlink" href="/pool-surrounds">Pool surrounds</a> <a class="tlink" href="/driveways">Driveways</a></p>
      </div>
    </div>
  </section>

  <!-- Pricing: the one light band on the page -->
  <section class="band light" id="pricing">
    <div class="wrap price-grid">
      <div data-reveal>
        <p class="kicker">What it costs</p>
        <p class="price"><span class="from">From</span> $15</p>
        <p class="per">per square metre</p>
      </div>
      <div class="price-copy">
        <p>Your price comes down to two things:</p>
        <ol class="price-factors">
          <li>The sealer you choose</li>
          <li>What the job needs</li>
        </ol>
        <p class="small">Rural jobs carry a separate travel fee, quoted up front.</p>
        <div class="cta-row">
          <a class="btn btn-navy" href="/book-now">Book a quote</a>
          <a class="tlink" href="/pricing">See pricing in detail</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Process -->
  <section class="band" id="process">
    <div class="wrap">
      <h2 data-reveal>How a job runs</h2>
      <ol class="steps" data-reveal>
        <li>
          <span class="step-n" aria-hidden="true">1</span>
          <h3>Send photos</h3>
          <p>Photos and the rough size of the area. We come back with a price within <span class="todo-inline">[timeframe]</span>.</p>
        </li>
        <li>
          <span class="step-n" aria-hidden="true">2</span>
          <h3>Book a date</h3>
          <p>We tell you how long the area needs to stay clear before and after.</p>
        </li>
        <li>
          <span class="step-n" aria-hidden="true">3</span>
          <h3>Test, clean, seal</h3>
          <p>We test a patch first so you see the result, then clean, lift any stains and seal.</p>
        </li>
        <li>
          <span class="step-n" aria-hidden="true">4</span>
          <h3>Look after it</h3>
          <p>You get care instructions and a guide to when it'll need resealing.</p>
        </li>
      </ol>
    </div>
  </section>

  <!-- Before and after: appears once src/data/gallery.js has pairs -->
  {pairs.length > 0 && (
    <section class="band hairline-top" id="gallery">
      <div class="wrap">
        <h2 data-reveal>Before and after</h2>
        <div class="ba-grid">
          {pairs.slice(0, 2).map((p) => <BeforeAfter before={p.before} after={p.after} caption={`${p.caption}, ${p.suburb}`} />)}
        </div>
        <p class="gallery-link"><a class="tlink" href="/gallery">See more of our work</a></p>
      </div>
    </section>
  )}

  <!-- Review -->
  <section class="band textured review-band">
    <StoneTexture id="tx-review" shade={0.62} />
    <div class="wrap">
      <figure class="review" data-reveal>
        <span class="quote-mark" aria-hidden="true">“</span>
        <blockquote>
          <p class="quote-text">Great team at Spickle Cleaning, they were a pleasure to deal with, super friendly, and provided a great finish to our crazy paving in our fire pit area!</p>
        </blockquote>
        <figcaption>
          <span class="who">Brad, Cheltenham</span>
          <span class="src"><span class="stars" role="img" aria-label="5 out of 5 stars">★★★★★</span> Google review</span>
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- Who and where -->
  <section class="band">
    <div class="wrap two-col" data-reveal>
      <div>
        <h3>Who we work for</h3>
        <p>Homeowners, property managers, body corporates and golf clubs across Melbourne.</p>
      </div>
      <div>
        <h3>Where we work</h3>
        <p>Melbourne's inner, eastern and south-east suburbs and the Mornington Peninsula, from Abbotsford to Sorrento. Further out, we travel for a separate fee.</p>
        <a class="tlink" href="/service-areas">See all suburbs</a>
      </div>
    </div>
  </section>

  <!-- Book -->
  <section class="band textured" id="quote">
    <StoneTexture id="tx-book" shade={0.74} />
    <div class="wrap book-grid">
      <div data-reveal>
        <h2>Book a quote</h2>
        <p>Send a few photos and the rough size of the area, and we'll come back with a price.</p>
        <div class="cta-row">
          <a class="tlink" href="tel:1300220045">Call 1300 22 00 45</a>
          <a class="tlink" href="mailto:info@spickle.com.au">info@spickle.com.au</a>
        </div>
      </div>
      <div class="todo book-embed">ServiceM8 booking form<br />[Embed from ServiceM8 goes here: name, phone, email, address, approximate m², paving type, photos]</div>
    </div>
  </section>
</Base>

<style>
  /* Hero */
  .hero { position: relative; overflow: hidden; }
  .hero :global(.hero-bg) {
    position: absolute; inset: 0; width: 100%; height: 100%;
    object-fit: cover; object-position: 50% 62%;
  }
  @media (prefers-reduced-motion: no-preference) {
    .hero :global(.hero-bg) { animation: settle 2.4s cubic-bezier(0.2, 0.7, 0.2, 1) both; }
    .hero-copy > *, .facts { animation: rise 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) both; }
    .hero-copy > :nth-child(2) { animation-delay: 0.1s; }
    .hero-copy > :nth-child(3) { animation-delay: 0.2s; }
    .hero-copy > :nth-child(4) { animation-delay: 0.3s; }
    .facts { animation-delay: 0.4s; }
  }
  @keyframes settle { from { transform: scale(1.08); } to { transform: scale(1); } }
  @keyframes rise { from { opacity: 0; transform: translateY(16px); } to { opacity: 1; transform: none; } }
  .hero-shade {
    position: absolute; inset: 0;
    background: linear-gradient(180deg, rgba(0,47,73,0.72) 0%, rgba(0,47,73,0.28) 42%, rgba(0,32,47,0.9) 100%);
  }
  .hero-inner {
    position: relative;
    min-height: calc(100svh - 76px);
    justify-content: flex-end;
    padding-top: clamp(5rem, 10vw, 8rem);
    padding-bottom: clamp(2rem, 4vw, 3.25rem);
    display: flex; flex-direction: column; gap: clamp(2.25rem, 5vw, 4rem);
  }
  .hero-copy { max-width: 820px; display: flex; flex-direction: column; gap: 1.5rem; }
  .hero-copy h1 { margin: 0; }
  .lede { font-size: var(--step-1); line-height: 1.5; max-width: 34ch; color: #d6e8ee; margin: 0; }
  .rating { margin: 0; font-size: var(--step--1); color: var(--muted); display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap; }
  .stars { color: #f2c94c; letter-spacing: 0.12em; font-size: 1rem; }
  .cta-row { display: flex; flex-wrap: wrap; align-items: center; gap: 0.9rem 1.6rem; }
  .facts {
    margin: 0; padding-top: 1.4rem; border-top: 1px solid rgba(255,255,255,0.3);
    display: grid; grid-template-columns: repeat(auto-fit, minmax(min(200px, 100%), 1fr)); gap: 1.25rem;
  }
  .facts dt { font-family: var(--display); font-size: var(--step-2); color: var(--white); }
  .facts dd { margin: 0.2rem 0 0; font-size: var(--step--1); color: #c3d6dd; }

  /* Split sections */
  .split { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(420px, 100%), 1fr)); gap: clamp(2rem, 5vw, 5rem); align-items: start; }
  .split h2 { margin: 0; }
  .split-copy { max-width: 560px; }
  .trade { margin-top: 1.4rem; padding-top: 1.4rem; border-top: 1px solid var(--hairline); }
  .trade h3 { margin-bottom: 0.4em; }

  /* Sealing */
  .section-lede { margin-bottom: clamp(2rem, 4vw, 3rem); }
  .seal-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(440px, 100%), 1fr)); gap: clamp(2rem, 4vw, 4rem); align-items: center; }
  .seal-types { display: grid; gap: 2rem; max-width: 480px; }

  /* Stones */
  .row-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: 1rem 3rem; margin-bottom: clamp(2rem, 4vw, 3.25rem); }
  .row-head h2 { margin: 0; }
  .also { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 0.5rem 2rem; margin-top: clamp(1.5rem, 3vw, 2.25rem); padding-top: 1.25rem; border-top: 1px solid var(--hairline); }
  .also p { margin: 0; }
  .also-links { display: flex; flex-wrap: wrap; align-items: center; gap: 0 1.4rem; color: var(--muted); }
  .row-head p { margin: 0; max-width: 46ch; }
  .stone-grid {
    list-style: none; margin: 0; padding: 0;
    display: grid; grid-template-columns: repeat(4, 1fr); gap: clamp(0.75rem, 1.6vw, 1.25rem);
  }
  @media (max-width: 860px) { .stone-grid { grid-template-columns: repeat(2, 1fr); } }
  .stone-grid a {
    position: relative; display: block; overflow: hidden; isolation: isolate;
    aspect-ratio: 4 / 5; border-radius: 6px;
    color: var(--white); text-decoration: none;
    box-shadow: 0 18px 40px -24px rgba(0, 0, 0, 0.7);
  }
  .stone-grid :global(img) {
    position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: -2;
    transition: transform 0.7s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .stone-grid a::after {
    content: ''; position: absolute; inset: 0; z-index: -1;
    background: linear-gradient(180deg, rgba(0,32,47,0) 35%, rgba(0,32,47,0.88) 100%);
    transition: background-color 0.4s;
  }
  .stone-info { position: absolute; left: 0; right: 0; bottom: 0; padding: 1.1rem 1.1rem 1.15rem; display: grid; gap: 0.45rem; }
  .stone-name { font-family: var(--display); font-size: clamp(1.25rem, 1rem + 0.8vw, 1.6rem); line-height: 1.1; }
  .stone-tag {
    font-size: 0.9rem; line-height: 1.4; color: #d6e8ee;
    display: grid; grid-template-rows: 0fr; opacity: 0;
    transition: grid-template-rows 0.45s ease, opacity 0.35s ease;
  }
  .stone-arrow {
    position: absolute; top: 0.9rem; right: 0.9rem;
    width: 36px; height: 36px; border-radius: 50%;
    display: grid; place-items: center;
    background: rgba(255,255,255,0.14); backdrop-filter: blur(6px);
    transition: background-color 0.3s, color 0.3s, transform 0.3s;
  }
  @media (hover: hover) {
    .stone-grid a:hover :global(img), .stone-grid a:focus-visible :global(img) { transform: scale(1.07); }
    .stone-grid a:hover::after, .stone-grid a:focus-visible::after { background-color: rgba(0,32,47,0.35); }
    .stone-grid a:hover .stone-tag, .stone-grid a:focus-visible .stone-tag { grid-template-rows: 1fr; opacity: 1; }
    .stone-grid a:hover .stone-arrow, .stone-grid a:focus-visible .stone-arrow { background: var(--teal); color: var(--navy-deep); transform: rotate(-45deg); }
  }
  .stone-tag { overflow: hidden; }
  @media (hover: none) { .stone-tag { display: none; } }

  /* Pricing */
  .price-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(380px, 100%), 1fr)); gap: clamp(2.25rem, 6vw, 6rem); align-items: center; }
  .kicker { font-size: var(--step-0); font-weight: 600; color: var(--teal-deep); margin-bottom: 0.4rem; }
  .price .from { display: block; font-family: var(--font); font-size: var(--step-1); font-weight: 600; line-height: 1.2; color: var(--teal-deep); margin-bottom: 0.3rem; }
  .price { font-family: var(--display); font-size: clamp(3.75rem, 9vw, 8.5rem); line-height: 0.95; color: var(--navy); margin: 0; }
  .per { font-size: var(--step-1); margin: 0.5rem 0 0; }
  .price-copy { max-width: 520px; }
  .price-factors {
    margin: 0 0 1em; padding: 0; list-style: none;
    border-top: 1px solid #b9d2cb;
  }
  .price-factors li { padding: 0.9rem 0; border-bottom: 1px solid #b9d2cb; font-size: var(--step-1); font-weight: 600; color: var(--navy); }
  .small { font-size: var(--step--1); }

  /* Process */
  .steps {
    margin: 0; padding: 0; list-style: none;
    display: grid; grid-template-columns: repeat(auto-fit, minmax(min(230px, 100%), 1fr)); gap: clamp(1.75rem, 3vw, 2.5rem);
  }
  .steps li { position: relative; padding-top: 1.4rem; }
  .steps li::before {
    content: ''; position: absolute; top: 0; left: 0; right: 0; height: 2px;
    background: var(--teal); transform-origin: left;
  }
  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) .steps li::before { transform: scaleX(0); transition: transform 0.9s cubic-bezier(0.6, 0, 0.2, 1); }
    :global(html.js) .steps.in li::before { transform: scaleX(1); }
    :global(html.js) .steps.in li:nth-child(2)::before { transition-delay: 0.2s; }
    :global(html.js) .steps.in li:nth-child(3)::before { transition-delay: 0.4s; }
    :global(html.js) .steps.in li:nth-child(4)::before { transition-delay: 0.6s; }
  }
  .step-n { font-family: var(--display); font-size: clamp(2.75rem, 2rem + 2vw, 3.75rem); line-height: 1; color: var(--teal-bright); display: block; margin-bottom: 0.6rem; }
  .steps h3 { margin-bottom: 0.35em; }
  .steps p { font-size: 1rem; margin: 0; }

  /* Review */
  .textured { position: relative; isolation: isolate; }
  .review-band { padding-block: clamp(5rem, 11vw, 10rem); }
  .review { margin: 0; max-width: 980px; position: relative; }
  .quote-mark { display: block; font-family: var(--display); font-size: clamp(5rem, 10vw, 8rem); line-height: 0.6; color: var(--teal-bright); margin-bottom: 0.2rem; }
  .review blockquote { margin: 0; }
  .quote-text { font-family: var(--display); font-size: clamp(1.6rem, 3vw, 2.6rem); line-height: 1.3; color: var(--white); max-width: none; }
  .review figcaption { display: flex; flex-wrap: wrap; gap: 0.4rem 1.5rem; font-size: 1rem; color: var(--muted); }
  .review .who { font-weight: 600; color: var(--white); }
  .review .src { display: inline-flex; align-items: center; gap: 0.5rem; }

  .two-col { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(360px, 100%), 1fr)); gap: clamp(2rem, 5vw, 5rem); }
  .gallery-link { margin: 1.5rem 0 0; }
  .ba-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(420px, 100%), 1fr)); gap: clamp(1.5rem, 3vw, 2.5rem); }

  /* Book */
  .book-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(400px, 100%), 1fr)); gap: clamp(2rem, 6vw, 6rem); align-items: center; }
  .book-embed { min-height: 300px; display: flex; flex-direction: column; justify-content: center; line-height: 1.7; }
</style>
