---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { PRELAUNCH, ABN } from '../config/site.js';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  /** Extra JSON-LD objects for this page (Article, Service, BreadcrumbList) */
  schema?: object[];
}
const { title, description, noindex = false, schema = [] } = Astro.props;
// build.format 'file' gives paths like /services.html; Vercel serves them at
// /services (cleanUrls), so canonical and og:url must use the clean form.
const cleanPath = Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '/') || '/';
const canonical = new URL(cleanPath === '/index' ? '/' : cleanPath, Astro.site);

const business = {
  '@context': 'https://schema.org',
  '@type': 'HomeAndConstructionBusiness',
  name: 'Spickle Cleaning & Sealing',
  legalName: 'Spickle Pty Ltd',
  taxID: `ABN ${ABN}`,
  image: 'https://www.spickle.com.au/og-image.jpg',
  url: 'https://www.spickle.com.au',
  telephone: '+61 1300 22 00 45',
  email: 'info@spickle.com.au',
  logo: 'https://www.spickle.com.au/logo-colour.png',
  areaServed: [
    { '@type': 'City', name: 'Melbourne' },
    { '@type': 'Place', name: 'Mornington Peninsula' },
  ],
  sameAs: [
    'https://www.facebook.com/profile.php?id=100088685563706',
    'https://instagram.com/spickle_sealing',
  ],
  priceRange: 'From $15 per m²',
};
---
<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <script is:inline>document.documentElement.classList.add('js')</script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#002f49" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content="https://www.spickle.com.au/og-image.jpg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {(PRELAUNCH || noindex) && <meta name="robots" content="noindex" />}
    <script type="application/ld+json" set:html={JSON.stringify(business)} />
    {schema.map((obj) => <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', ...obj })} />)}
    <!-- Vercel Web Analytics: enable it on the Vercel project (Analytics tab) for this to record -->
    <script defer src="/_vercel/insights/script.js"></script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>
      const els = document.querySelectorAll<HTMLElement>('[data-reveal]');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver((entries) => {
          for (const e of entries) {
            if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
          }
        }, { rootMargin: '0px 0px -12% 0px' });
        els.forEach((el) => io.observe(el));
      } else {
        els.forEach((el) => el.classList.add('in'));
      }
    </script>
  </body>
</html>
