---
import { BOOKING_URL } from '../config/site.js';
---
<div class="booking-card">
  <h3>Request a quote online</h3>
  <ol class="bk-steps">
    <li>Your name, phone, email and the job address</li>
    <li>In the description, tell us the stone and the rough size in m² (<a href="/book-now#area">work it out here</a>)</li>
    <li>Attach a few photos of the area as it is now</li>
  </ol>
  <a class="btn btn-primary bk-btn" href={BOOKING_URL}>Book a quote</a>
  <p class="bk-note">Takes about two minutes. Opens our booking form, run by ServiceM8. Rather talk? <a href="tel:1300220045">1300 22 00 45</a></p>
</div>

<style>
  .booking-card {
    padding: clamp(1.5rem, 3vw, 2rem);
    border: 1px solid var(--hairline); border-radius: 8px;
    background: var(--surface, #fff);
    box-shadow: 0 24px 48px -32px rgba(0, 47, 73, 0.35);
  }
  .booking-card h3 { margin-bottom: 0.9rem; }
  .bk-steps { margin: 0 0 1.5rem; padding-left: 1.3rem; display: grid; gap: 0.55rem; color: var(--text); }
  .bk-steps li::marker { color: var(--accent); font-weight: 700; }
  .bk-btn { width: 100%; }
  .bk-note { margin: 0.9rem 0 0; font-size: var(--step--1); color: var(--muted); }
</style>
