---
// Bluestone pavers: left half unsealed (water soaks in), right half sealed (water beads).
const drops = [
  [368, 58, 17], [440, 40, 10], [508, 84, 22], [590, 52, 13], [618, 132, 9],
  [400, 136, 12], [470, 168, 16], [556, 160, 11], [604, 196, 7], [378, 252, 20],
  [446, 292, 10], [520, 258, 18], [598, 248, 14], [350, 330, 8], [418, 354, 14],
  [492, 384, 21], [566, 338, 11], [612, 400, 15], [372, 412, 9], [540, 420, 7],
  [462, 226, 6], [338, 196, 6],
];
---
<figure class="seal-demo">
  <svg viewBox="0 0 640 440" role="img" aria-labelledby="seal-title seal-desc">
    <title id="seal-title">Unsealed and sealed bluestone side by side</title>
    <desc id="seal-desc">On the unsealed paver, water soaks in and leaves a dark stain. On the sealed paver, the same water sits on top in round beads.</desc>
    <defs>
      <filter id="grain" x="0" y="0" width="100%" height="100%">
        <feTurbulence type="fractalNoise" baseFrequency="0.85" numOctaves="3" seed="7" />
        <feColorMatrix type="matrix" values="0 0 0 0 0.10  0 0 0 0 0.13  0 0 0 0 0.16  0 0 0 1.6 -0.62" />
      </filter>
      <filter id="mottle" x="0" y="0" width="100%" height="100%">
        <feTurbulence type="fractalNoise" baseFrequency="0.012" numOctaves="2" seed="3" />
        <feColorMatrix type="matrix" values="0 0 0 0 0.85  0 0 0 0 0.9  0 0 0 0 0.92  0 0 0 0.5 -0.12" />
      </filter>
      <filter id="soft" x="-20%" y="-20%" width="140%" height="140%">
        <feGaussianBlur stdDeviation="7" />
      </filter>
      <radialGradient id="drop-body" cx="38%" cy="32%" r="70%">
        <stop offset="0" stop-color="#ffffff" stop-opacity="0.35" />
        <stop offset="0.55" stop-color="#7d93a0" stop-opacity="0.18" />
        <stop offset="1" stop-color="#0b2a3a" stop-opacity="0.45" />
      </radialGradient>
      <linearGradient id="sheen" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#ffffff" stop-opacity="0.16" />
        <stop offset="0.5" stop-color="#ffffff" stop-opacity="0" />
        <stop offset="1" stop-color="#ffffff" stop-opacity="0.08" />
      </linearGradient>
      <clipPath id="left-pavers">
        <rect x="0" y="0" width="316" height="216" rx="3" />
        <rect x="0" y="224" width="316" height="216" rx="3" />
      </clipPath>
      <clipPath id="right-pavers">
        <rect x="324" y="0" width="316" height="216" rx="3" />
        <rect x="324" y="224" width="316" height="216" rx="3" />
      </clipPath>
    </defs>

    <!-- grout -->
    <rect width="640" height="440" fill="#b9c1c3" />

    <!-- left pavers: unsealed -->
    <g clip-path="url(#left-pavers)">
      <rect width="320" height="440" fill="#5d6a72" />
      <rect width="320" height="440" filter="url(#mottle)" />
      <rect width="320" height="440" filter="url(#grain)" />
      <path class="stain" filter="url(#soft)" fill="#1f2a30"
        d="M96 128c38-34 104-30 132 6 26 34 6 70 30 104 22 32-6 86-56 92-46 6-62-26-100-22-44 4-78-26-66-70 10-38-12-60 0-84 10-20 36-4 60-26z" />
    </g>

    <!-- right pavers: sealed -->
    <g clip-path="url(#right-pavers)">
      <rect x="320" width="320" height="440" fill="#5d6a72" />
      <rect x="320" width="320" height="440" filter="url(#mottle)" />
      <rect x="320" width="320" height="440" filter="url(#grain)" />
      <rect x="320" width="320" height="440" fill="url(#sheen)" />
      {drops.map(([x, y, r], i) => (
        <g class="drop" style={`--d:${0.9 + i * 0.07}s`}>
          <ellipse cx={x + r * 0.18} cy={y + r * 0.62} rx={r * 0.95} ry={r * 0.45} fill="#0d1d25" opacity="0.28" />
          <circle cx={x} cy={y} r={r} fill="url(#drop-body)" stroke="#dfe9ee" stroke-opacity="0.35" stroke-width="1" />
          <ellipse cx={x - r * 0.35} cy={y - r * 0.4} rx={r * 0.32} ry={r * 0.2} fill="#ffffff" opacity="0.85" transform={`rotate(-30 ${x - r * 0.35} ${y - r * 0.4})`} />
        </g>
      ))}
    </g>
  </svg>
  <figcaption>
    <span><strong>Unsealed.</strong> Water soaks in and darkens the stone. So does oil.</span>
    <span><strong>Sealed.</strong> The same water sits on top and wipes away.</span>
  </figcaption>
</figure>

<style>
  .seal-demo { margin: 0; }
  svg {
    width: 100%; height: auto; display: block;
    border-radius: 10px;
    box-shadow: 0 24px 50px -24px rgba(0, 47, 73, 0.55);
  }
  figcaption {
    display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;
    margin-top: 0.9rem; font-size: 0.95rem; color: var(--stone); line-height: 1.4;
  }
  figcaption strong { color: var(--navy); font-stretch: 112%; }
  figcaption span:last-child { padding-left: 0.4rem; }

  .stain {
    opacity: 0.6;
    transform-box: fill-box; transform-origin: 45% 50%;
    animation: soak 2.8s cubic-bezier(0.2, 0.7, 0.3, 1) 0.4s both;
  }
  .drop {
    transform-box: fill-box; transform-origin: 50% 100%;
    animation: bead 0.55s cubic-bezier(0.3, 1.5, 0.5, 1) var(--d) both;
  }
  @keyframes soak {
    from { transform: scale(0.15); opacity: 0.15; }
    to { transform: scale(1); opacity: 0.6; }
  }
  @keyframes bead {
    from { transform: scale(0); opacity: 0; }
    to { transform: scale(1); opacity: 1; }
  }
  @media (prefers-reduced-motion: reduce) {
    .stain, .drop { animation: none; }
  }
</style>
