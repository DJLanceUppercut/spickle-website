---
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="wrap grid">
    <div class="brand">
      <img src="/logo-white.png" alt="Spickle Cleaning & Sealing" width="180" height="53" loading="lazy" />
      <p>Stone and concrete cleaning and sealing across Melbourne and the Mornington Peninsula.</p>
    </div>
    <div>
      <h2 class="f-head">Contact</h2>
      <ul>
        <li><a href="tel:1300220045">1300 22 00 45</a></li>
        <li><a href="mailto:info@spickle.com.au">info@spickle.com.au</a></li>
        <li><a href="https://instagram.com/spickle_sealing">Instagram</a></li>
        <li><a href="https://www.facebook.com/profile.php?id=100088685563706">Facebook</a></li>
      </ul>
    </div>
    <div>
      <h2 class="f-head">Services</h2>
      <ul>
        <li><a href="/services#new-install">New installation sealing</a></li>
        <li><a href="/services#cleaning">Cleaning</a></li>
        <li><a href="/services#sealing">Sealing</a></li>
        <li><a href="/services#stains">Stain removal</a></li>
        <li><a href="/#pricing">Pricing</a></li>
      </ul>
    </div>
    <div>
      <h2 class="f-head">Site</h2>
      <ul>
        <li><a href="/#stones">Stones we work with</a></li>
        <li><a href="/faq">FAQ</a></li>
        <li><a href="/book-now">Book a quote</a></li>
        <li><a href="/contact">Contact</a></li>
      </ul>
    </div>
  </div>
  <div class="wrap legal">
    <p>© {year} Spickle Pty Ltd. ABN <span class="todo-inline">[ABN to add]</span></p>
  </div>
</footer>

<style>
  .site-footer { background: var(--navy-deep); color: var(--faint); padding: 4rem 0 2rem; }
  .grid { display: grid; grid-template-columns: 1.6fr 1fr 1fr 1fr; gap: 2.5rem; }
  .brand img { width: 170px; margin-bottom: 1rem; }
  .brand p { font-size: 1rem; max-width: 30ch; color: var(--faint); }
  .f-head { color: var(--white); font-family: var(--font); font-size: 1rem; font-weight: 700; margin-bottom: 0.9rem; }
  ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.45rem; }
  a { color: var(--muted); text-decoration: none; font-size: 1rem; }
  a:hover { color: var(--white); text-decoration: underline; text-decoration-color: var(--teal); }
  .legal { margin-top: 3rem; padding-top: 1.5rem; border-top: 1px solid var(--hairline); }
  .legal p { font-size: 0.875rem; margin: 0; max-width: none; color: var(--faint); }
  @media (max-width: 860px) { .grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 640px) { .site-footer { padding-bottom: 6rem; } }
  @media (max-width: 480px) { .grid { grid-template-columns: 1fr; } }
</style>
