---
// Area calculator: add rectangles, get total m² and the starting price.
// Hidden without JavaScript (the booking info above it still works).
const RATE = 15;
---
<div class="calc" id="area" data-calc data-rate={RATE} hidden>
  <h2 class="calc-title">Work out your area</h2>
  <p class="calc-help">Measure each part in metres. Split L-shapes and odd areas into rectangles and add them one at a time.</p>

  <div class="rows" data-rows></div>

  <button type="button" class="add" data-add>+ Add another area</button>

  <div class="result" aria-live="polite">
    <div>
      <span class="r-label">Total area</span>
      <span class="r-val"><span data-total>0</span> m²</span>
    </div>
    <div>
      <span class="r-label">Starting price</span>
      <span class="r-val">from $<span data-price>0</span></span>
    </div>
  </div>
  <p class="calc-note">A guide, not a quote: ${RATE}/m² is where pricing starts. Your price depends on the sealer and what the job needs. Put the total area in your booking.</p>

  <template data-row-tpl>
    <div class="row">
      <label class="f-name"><span>Area</span><input type="text" placeholder="e.g. Pool surround" data-name /></label>
      <label><span>Length (m)</span><input type="number" inputmode="decimal" min="0" step="0.1" data-l /></label>
      <span class="x" aria-hidden="true">×</span>
      <label><span>Width (m)</span><input type="number" inputmode="decimal" min="0" step="0.1" data-w /></label>
      <span class="row-area"><span data-row-area>0</span> m²</span>
      <button type="button" class="rm" data-rm aria-label="Remove this area">×</button>
    </div>
  </template>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-calc]').forEach((calc) => {
    calc.hidden = false;
    const rate = Number(calc.dataset.rate) || 15;
    const rows = calc.querySelector<HTMLElement>('[data-rows]')!;
    const tpl = calc.querySelector<HTMLTemplateElement>('[data-row-tpl]')!;
    const totalEl = calc.querySelector('[data-total]')!;
    const priceEl = calc.querySelector('[data-price]')!;
    const fmt = (n: number) => (Math.round(n * 10) / 10).toLocaleString('en-AU');

    const update = () => {
      let total = 0;
      rows.querySelectorAll<HTMLElement>('.row').forEach((r) => {
        const l = parseFloat((r.querySelector('[data-l]') as HTMLInputElement).value) || 0;
        const w = parseFloat((r.querySelector('[data-w]') as HTMLInputElement).value) || 0;
        const a = Math.max(0, l * w);
        r.querySelector('[data-row-area]')!.textContent = fmt(a);
        total += a;
      });
      totalEl.textContent = fmt(total);
      priceEl.textContent = Math.round(total * rate).toLocaleString('en-AU');
      const many = rows.children.length > 1;
      rows.querySelectorAll<HTMLButtonElement>('[data-rm]').forEach((b) => (b.hidden = !many));
    };

    const addRow = (focus = false) => {
      const node = tpl.content.firstElementChild!.cloneNode(true) as HTMLElement;
      rows.appendChild(node);
      node.addEventListener('input', update);
      node.querySelector('[data-rm]')!.addEventListener('click', () => { node.remove(); update(); });
      if (focus) (node.querySelector('[data-l]') as HTMLInputElement).focus();
      update();
    };

    calc.querySelector('[data-add]')!.addEventListener('click', () => addRow(true));
    addRow();
  });
</script>

<style>
  .calc {
    margin-top: 2rem; padding: clamp(1.25rem, 3vw, 1.75rem);
    border: 1px solid var(--hairline); border-radius: 8px;
    background: rgba(255, 255, 255, 0.03);
    scroll-margin-top: 90px;
  }
  .calc-title { font-size: var(--step-1); margin: 0 0 0.3rem; }
  .calc-help { margin: 0 0 1.25rem; font-size: var(--step--1); color: var(--muted); }
  .rows { display: grid; gap: 0.9rem; }
  .row { display: grid; grid-template-columns: 1fr auto 1fr auto auto; gap: 0.6rem; align-items: end; }
  .f-name { grid-column: 1 / -1; }
  .row label { display: grid; gap: 0.3rem; font-size: 0.82rem; color: var(--muted); }
  .row input {
    width: 100%; min-height: 44px; padding: 0.5rem 0.7rem;
    font: inherit; font-size: 1rem; color: var(--white);
    background: rgba(0, 32, 47, 0.6); border: 1px solid rgba(255, 255, 255, 0.25); border-radius: 6px;
  }
  .row input:focus { outline: 2px solid var(--teal-bright); outline-offset: 1px; border-color: transparent; }
  .x { padding-bottom: 0.7rem; color: var(--muted); }
  .row-area { padding-bottom: 0.7rem; white-space: nowrap; color: var(--white); font-weight: 600; min-width: 4.5rem; text-align: right; }
  .rm {
    width: 44px; height: 44px; border-radius: 50%; border: 1px solid var(--hairline);
    background: none; color: var(--muted); font-size: 1.2rem; cursor: pointer;
  }
  .rm:hover { color: var(--white); border-color: var(--white); }
  .add {
    margin-top: 1rem; min-height: 44px; padding: 0 1.1rem;
    font: inherit; font-weight: 600; color: var(--teal-bright);
    background: none; border: 1px dashed rgba(33, 158, 188, 0.6); border-radius: 999px; cursor: pointer;
  }
  .add:hover { border-style: solid; background: rgba(33, 158, 188, 0.1); }
  .result {
    display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;
    margin-top: 1.4rem; padding-top: 1.2rem; border-top: 1px solid var(--hairline);
  }
  .result > div { display: grid; gap: 0.2rem; }
  .r-label { font-size: 0.85rem; color: var(--muted); }
  .r-val { font-family: var(--display); font-size: clamp(1.8rem, 1.3rem + 1.6vw, 2.6rem); line-height: 1.1; color: var(--white); }
  .calc-note { margin: 0.9rem 0 0; font-size: 0.85rem; color: var(--muted); }
  .row + :global(.row), .rows > .row:not(:last-child) { padding-bottom: 0.9rem; border-bottom: 1px solid var(--hairline); }
  @media (max-width: 560px) {
    .row { grid-template-columns: 1fr auto 1fr; }
    .row-area { grid-column: 1 / 3; text-align: left; padding: 0; align-self: center; }
    .rm { grid-column: 3; justify-self: end; }
  }
</style>
