---
const links = [
  { href: '/#stones', label: 'Stones' },
  { href: '/services', label: 'Services' },
  { href: '/pricing', label: 'Pricing' },
  { href: '/gallery', label: 'Our work' },
  { href: '/faq', label: 'FAQ' },
  { href: '/contact', label: 'Contact' },
];

// Mark the current page for the nav (aria-current) and its underline.
const here = Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '/') || '/';
const isCurrent = (href: string) => {
  if (href.includes('#')) return false;
  return href === '/' ? here === '/' : here === href || here.startsWith(href + '/');
};
---
<header class="site-header">
  <div class="wrap bar">
    <a href="/" class="logo" aria-label="Spickle Cleaning & Sealing, home">
      <img src="/logo-colour.png" alt="Spickle Cleaning & Sealing" width="160" height="47" />
    </a>
    <nav class="desk-nav" aria-label="Main">
      <ul>
        {links.map((l) => <li><a href={l.href} aria-current={isCurrent(l.href) ? 'page' : undefined}>{l.label}</a></li>)}
      </ul>
    </nav>
    <div class="actions">
      <a class="phone" href="tel:1300220045">1300 22 00 45</a>
      <a class="btn btn-primary" href="/book-now">Book a quote</a>
    </div>
    <button class="menu-btn" type="button" aria-haspopup="dialog" aria-expanded="false" aria-controls="mobile-menu">
      <span class="menu-label">Menu</span>
      <span class="burger" aria-hidden="true"><span></span><span></span></span>
    </button>
  </div>
</header>

<!-- Native modal dialog: the page behind is inert, Escape closes it and
     focus returns to the Menu button, all handled by the browser. -->
<dialog class="mobile-menu" id="mobile-menu" aria-label="Menu">
  <div class="mm-top">
    <a href="/" class="logo" aria-label="Spickle Cleaning & Sealing, home">
      <img src="/logo-white.png" alt="Spickle Cleaning & Sealing" width="160" height="47" />
    </a>
    <form method="dialog">
      <button class="mm-close" type="submit" autofocus>
        <span>Close</span>
        <span class="burger is-x" aria-hidden="true"><span></span><span></span></span>
      </button>
    </form>
  </div>
  <nav aria-label="Main">
    <ul>
      <li><a href="/" aria-current={here === '/' ? 'page' : undefined}>Home</a></li>
      {links.map((l) => <li><a href={l.href} aria-current={isCurrent(l.href) ? 'page' : undefined}>{l.label}</a></li>)}
    </ul>
  </nav>
  <div class="mm-foot">
    <a class="btn btn-primary" href="/book-now">Book a quote</a>
    <a class="tlink" href="tel:1300220045">Call 1300 22 00 45</a>
  </div>
</dialog>

<div class="mobile-bar" role="navigation" aria-label="Quick contact">
  <a href="tel:1300220045">Call 1300 22 00 45</a>
  <a href="/book-now" class="mb-quote">Book a quote</a>
</div>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.menu-btn');
  const menu = document.getElementById('mobile-menu') as HTMLDialogElement | null;
  if (btn && menu) {
    btn.addEventListener('click', () => menu.showModal());
    menu.addEventListener('toggle', () => btn.setAttribute('aria-expanded', String(menu.open)));
    menu.addEventListener('close', () => btn.setAttribute('aria-expanded', 'false'));
    // Links close the menu (matters for same-page links like /#stones).
    menu.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('a')) menu.close(); });
    matchMedia('(min-width: 981px)').addEventListener('change', (e) => { if (e.matches && menu.open) menu.close(); });
  }
</script>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 70;
    background: var(--header-bg);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--hairline);
  }
  .bar { display: flex; align-items: center; gap: 2rem; min-height: 76px; }
  .logo img { width: 150px; height: auto; }
  .desk-nav { margin-left: auto; }
  .desk-nav ul { display: flex; gap: 1.6rem; list-style: none; margin: 0; padding: 0; }
  .desk-nav a { color: var(--muted); text-decoration: none; font-weight: 500; font-size: 1rem; padding-block: 0.8rem; }
  .desk-nav a[aria-current='page'] { color: var(--strong); text-decoration: underline; text-decoration-color: var(--teal); text-decoration-thickness: 2px; text-underline-offset: 0.45em; }
  .desk-nav a:hover { color: var(--strong); text-decoration: underline; text-decoration-color: var(--teal); text-underline-offset: 0.3em; }
  .actions { display: flex; align-items: center; gap: 1.25rem; }
  .phone { color: var(--strong); font-weight: 800; text-decoration: none; white-space: nowrap; padding-block: 0.8rem; }
  .actions .btn { padding: 0.6rem 1.25rem; font-size: 1rem; }

  .menu-btn {
    display: none; align-items: center; gap: 0.7rem;
    min-height: 44px; padding: 0 0.25rem 0 0.9rem;
    background: none; border: 0; color: var(--strong);
    font: inherit; font-weight: 600; font-size: 1rem; cursor: pointer;
  }
  .burger { position: relative; width: 26px; height: 14px; display: block; }
  .burger span {
    position: absolute; left: 0; right: 0; height: 2px; background: currentColor;
    transition: transform 0.25s ease, top 0.25s ease;
  }
  .burger span:first-child { top: 0; }
  .burger span:last-child { top: 12px; }
  .menu-btn[aria-expanded='true'] .burger span:first-child { top: 6px; transform: rotate(45deg); }
  .menu-btn[aria-expanded='true'] .burger span:last-child { top: 6px; transform: rotate(-45deg); }

  .mobile-menu {
    /* Reset the UA dialog box to a full-screen sheet */
    position: fixed; inset: 0; margin: 0; border: 0;
    width: 100%; height: 100%; max-width: none; max-height: none;
    background: var(--navy-deep);
    padding: 0 var(--gutter) calc(2rem + env(safe-area-inset-bottom));
    flex-direction: column; justify-content: space-between; gap: 2rem;
    overflow-y: auto; overscroll-behavior: contain;
  }
  .mobile-menu[open] { display: flex; }
  .mobile-menu::backdrop { background: var(--navy-deep); }
  .mm-top { display: flex; align-items: center; justify-content: space-between; min-height: 64px; }
  .mm-top .logo img { width: 124px; height: auto; }
  .mm-top form { margin: 0; }
  .mm-close {
    display: inline-flex; align-items: center; gap: 0.7rem;
    min-height: 44px; padding: 0 0.25rem 0 0.9rem;
    background: none; border: 0; color: var(--strong);
    font: inherit; font-weight: 600; font-size: 1rem; cursor: pointer;
  }
  .burger.is-x span:first-child { top: 6px; transform: rotate(45deg); }
  .burger.is-x span:last-child { top: 6px; transform: rotate(-45deg); }
  .mobile-menu ul { list-style: none; margin: 0; padding: 0; }
  .mobile-menu li { border-bottom: 1px solid var(--hairline); }
  .mobile-menu li a {
    display: block; padding: 0.85rem 0;
    font-family: var(--display); font-size-adjust: var(--display-adjust);
    font-size: clamp(1.9rem, 8vw, 2.6rem); line-height: 1.15;
    color: var(--strong); text-decoration: none;
  }
  .mobile-menu li a:hover { color: var(--teal-bright); }
  .mobile-menu li a[aria-current='page'] { text-decoration: underline; text-decoration-color: var(--teal); text-decoration-thickness: 2px; text-underline-offset: 0.2em; }
  .mm-foot { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 1.6rem; }
  :global(html:has(.mobile-menu[open])) { overflow: hidden; }

  /* Entry animation, opt-in for visitors who allow motion */
  @media (prefers-reduced-motion: no-preference) {
    .mobile-menu {
      transition: opacity 0.25s ease, display 0.25s, overlay 0.25s;
      transition-behavior: allow-discrete;
      opacity: 0;
    }
    .mobile-menu[open] {
      opacity: 1;
      @starting-style { opacity: 0; }
    }
    .mobile-menu[open] li a {
      transition: translate 0.35s ease, opacity 0.35s ease;
      @starting-style { translate: 0 10px; opacity: 0; }
    }
    .mobile-menu[open] li:nth-child(2) a { transition-delay: 0.03s; }
    .mobile-menu[open] li:nth-child(3) a { transition-delay: 0.06s; }
    .mobile-menu[open] li:nth-child(4) a { transition-delay: 0.09s; }
    .mobile-menu[open] li:nth-child(5) a { transition-delay: 0.12s; }
    .mobile-menu[open] li:nth-child(6) a { transition-delay: 0.15s; }
    .mobile-menu[open] li:nth-child(7) a { transition-delay: 0.18s; }
  }

  .mobile-bar { display: none; }


  @media (max-width: 980px) {
    .desk-nav { display: none; }
    .actions { margin-left: auto; }
    .menu-btn { display: inline-flex; }
    .bar { gap: 1rem; }
  }
  @media (max-width: 640px) {
    .bar { min-height: 64px; }
    .logo img { width: 124px; }
    .actions { display: none; }
    .menu-btn { margin-left: auto; }
    .mobile-bar {
      display: grid; grid-template-columns: 1fr 1fr;
      position: fixed; inset: auto 0 0 0; z-index: 60;
      background: var(--navy-deep);
      border-top: 1px solid var(--hairline);
      padding: 0.5rem 0.5rem calc(0.5rem + env(safe-area-inset-bottom));
      gap: 0.5rem;
    }
    .mobile-bar a {
      text-align: center; padding: 0.8rem 0.5rem; border-radius: 999px;
      color: var(--strong); font-weight: 700; text-decoration: none; font-size: 0.98rem;
      border: 2px solid rgba(255,255,255,0.5);
    }
    .mobile-bar .mb-quote { background: var(--teal); border-color: var(--teal); color: var(--navy-deep); }
  }
</style>
