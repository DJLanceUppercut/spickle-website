---
const links = [
  { href: '/#stones', label: 'Stones' },
  { href: '/services', label: 'Services' },
  { href: '/pricing', label: 'Pricing' },
  { href: '/gallery', label: 'Our work' },
  { href: '/faq', label: 'FAQ' },
  { href: '/contact', label: 'Contact' },
];
---
<header class="site-header">
  <div class="wrap bar">
    <a href="/" class="logo" aria-label="Spickle Cleaning & Sealing, home">
      <img src="/logo-white.png" alt="Spickle Cleaning & Sealing" width="160" height="47" />
    </a>
    <nav class="desk-nav" aria-label="Main">
      <ul>
        {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </nav>
    <div class="actions">
      <a class="phone" href="tel:1300220045">1300 22 00 45</a>
      <a class="btn btn-primary" href="/book-now">Book a quote</a>
    </div>
    <button class="menu-btn" type="button" aria-expanded="false" aria-controls="mobile-menu">
      <span class="menu-label">Menu</span>
      <span class="burger" aria-hidden="true"><span></span><span></span></span>
    </button>
  </div>
</header>

<div class="mobile-menu" id="mobile-menu" hidden>
  <nav aria-label="Main">
    <ul>
      <li><a href="/">Home</a></li>
      {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
    </ul>
  </nav>
  <div class="mm-foot">
    <a class="btn btn-primary" href="/book-now">Book a quote</a>
    <a class="tlink" href="tel:1300220045">Call 1300 22 00 45</a>
  </div>
</div>

<div class="mobile-bar" role="navigation" aria-label="Quick contact">
  <a href="tel:1300220045">Call 1300 22 00 45</a>
  <a href="/book-now" class="mb-quote">Book a quote</a>
</div>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.menu-btn');
  const menu = document.getElementById('mobile-menu');
  if (btn && menu) {
    const label = btn.querySelector('.menu-label');
    const setOpen = (open: boolean) => {
      btn.setAttribute('aria-expanded', String(open));
      if (label) label.textContent = open ? 'Close' : 'Menu';
      document.documentElement.classList.toggle('menu-open', open);
      if (open) {
        menu.hidden = false;
        requestAnimationFrame(() => menu.classList.add('open'));
        menu.querySelector('a')?.focus();
      } else {
        menu.classList.remove('open');
        setTimeout(() => { if (!menu.classList.contains('open')) menu.hidden = true; }, 250);
      }
    };
    btn.addEventListener('click', () => setOpen(btn.getAttribute('aria-expanded') !== 'true'));
    menu.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('a')) setOpen(false); });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && btn.getAttribute('aria-expanded') === 'true') { setOpen(false); btn.focus(); }
    });
    matchMedia('(min-width: 981px)').addEventListener('change', (e) => { if (e.matches) setOpen(false); });
  }
</script>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 70;
    background: rgba(0, 32, 47, 0.92);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--hairline);
  }
  .bar { display: flex; align-items: center; gap: 2rem; min-height: 76px; }
  .logo img { width: 150px; height: auto; }
  .desk-nav { margin-left: auto; }
  .desk-nav ul { display: flex; gap: 1.6rem; list-style: none; margin: 0; padding: 0; }
  .desk-nav a { color: var(--muted); text-decoration: none; font-weight: 500; font-size: 1rem; padding-block: 0.8rem; }
  .desk-nav a:hover { color: var(--white); text-decoration: underline; text-decoration-color: var(--teal); text-underline-offset: 0.3em; }
  .actions { display: flex; align-items: center; gap: 1.25rem; }
  .phone { color: var(--white); font-weight: 800; text-decoration: none; white-space: nowrap; padding-block: 0.8rem; }
  .actions .btn { padding: 0.6rem 1.25rem; font-size: 1rem; }

  .menu-btn {
    display: none; align-items: center; gap: 0.7rem;
    min-height: 44px; padding: 0 0.25rem 0 0.9rem;
    background: none; border: 0; color: var(--white);
    font: inherit; font-weight: 600; font-size: 1rem; cursor: pointer;
  }
  .burger { position: relative; width: 26px; height: 14px; display: block; }
  .burger span {
    position: absolute; left: 0; right: 0; height: 2px; background: currentColor;
    transition: transform 0.25s ease, top 0.25s ease;
  }
  .burger span:first-child { top: 0; }
  .burger span:last-child { top: 12px; }
  .menu-btn[aria-expanded='true'] .burger span:first-child { top: 6px; transform: rotate(45deg); }
  .menu-btn[aria-expanded='true'] .burger span:last-child { top: 6px; transform: rotate(-45deg); }

  .mobile-menu {
    position: fixed; inset: 0; z-index: 65;
    background: var(--navy-deep);
    padding: calc(64px + 2.5rem) var(--gutter) calc(2rem + env(safe-area-inset-bottom));
    display: flex; flex-direction: column; justify-content: space-between; gap: 2rem;
    overflow-y: auto;
    opacity: 0; transition: opacity 0.25s ease;
  }
  .mobile-menu.open { opacity: 1; }
  .mobile-menu ul { list-style: none; margin: 0; padding: 0; }
  .mobile-menu li { border-bottom: 1px solid var(--hairline); }
  .mobile-menu li a {
    display: block; padding: 0.85rem 0;
    font-family: var(--display); font-size: clamp(1.9rem, 8vw, 2.6rem); line-height: 1.15;
    color: var(--white); text-decoration: none;
    transform: translateY(10px); opacity: 0;
    transition: transform 0.35s ease, opacity 0.35s ease, color 0.15s;
  }
  .mobile-menu.open li a { transform: none; opacity: 1; }
  .mobile-menu.open li:nth-child(2) a { transition-delay: 0.03s; }
  .mobile-menu.open li:nth-child(3) a { transition-delay: 0.06s; }
  .mobile-menu.open li:nth-child(4) a { transition-delay: 0.09s; }
  .mobile-menu.open li:nth-child(5) a { transition-delay: 0.12s; }
  .mobile-menu.open li:nth-child(6) a { transition-delay: 0.15s; }
  .mobile-menu.open li:nth-child(7) a { transition-delay: 0.18s; }
  .mobile-menu li a:hover { color: var(--teal-bright); }
  .mm-foot { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 1.6rem; }
  :global(html.menu-open) { overflow: hidden; }
  :global(html.menu-open) .mobile-bar { display: none; }

  .mobile-bar { display: none; }

  @media (prefers-reduced-motion: reduce) {
    .mobile-menu, .mobile-menu li a, .burger span { transition: none; }
  }

  @media (max-width: 980px) {
    .desk-nav { display: none; }
    .actions { margin-left: auto; }
    .menu-btn { display: inline-flex; }
    .bar { gap: 1rem; }
  }
  @media (max-width: 640px) {
    .bar { min-height: 64px; }
    .logo img { width: 124px; }
    .actions { display: none; }
    .menu-btn { margin-left: auto; }
    .mobile-bar {
      display: grid; grid-template-columns: 1fr 1fr;
      position: fixed; inset: auto 0 0 0; z-index: 60;
      background: var(--navy-deep);
      border-top: 1px solid var(--hairline);
      padding: 0.5rem 0.5rem calc(0.5rem + env(safe-area-inset-bottom));
      gap: 0.5rem;
    }
    .mobile-bar a {
      text-align: center; padding: 0.8rem 0.5rem; border-radius: 999px;
      color: var(--white); font-weight: 700; text-decoration: none; font-size: 0.98rem;
      border: 2px solid rgba(255,255,255,0.5);
    }
    .mobile-bar .mb-quote { background: var(--teal); border-color: var(--teal); color: var(--navy-deep); }
  }
</style>
