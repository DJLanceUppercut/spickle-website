---
import { BOOKING_URL, SHOW_REVIEWS } from '../config/site.js';
import { Image } from 'astro:assets';
import { stones } from '../data/stones.js';
import { reviews } from '../data/reviews.js';

const { a } = Astro.props;
const linkedStones = a.stones.map((slug) => stones.find((s) => s.slug === slug)).filter(Boolean);
const review = reviews[0];
---
<section class="band hairline-top area-hero">
  <div class="wrap hero-grid">
    <div>
      <p class="crumb"><a href="/services">Services</a></p>
      <h1>{a.h1}</h1>
      <p class="lede">{a.tagline}</p>
      <div class="cta-row">
        <a class="btn btn-primary" href={BOOKING_URL}>Book a quote</a>
        <a class="tlink" href="tel:1300220045">Call 1300 22 00 45</a>
      </div>
      <p class="price">From <strong>$15 per m²</strong>, depending on the sealer and the job.</p>
    </div>
    <Image class="hero-img" src={a.image} alt={a.imageAlt} widths={[480, 900, 1200]} sizes="(max-width: 900px) 100vw, 50vw" loading="eager" fetchpriority="high" />
  </div>
</section>

<section class="band panel">
  <div class="wrap two">
    <div>
      <h2 data-reveal>What goes wrong</h2>
      <ul class="risks">
        {a.problems.map((p) => <li>{p}</li>)}
      </ul>
    </div>
    <div>
      <h2 data-reveal>How we treat it</h2>
      {a.treatment.map((p) => <p>{p}</p>)}
      <a class="tlink" href={a.guide.href}>{a.guide.text}</a>
    </div>
  </div>
</section>

<section class="band">
  <div class="wrap">
    <h2 data-reveal>Common stones</h2>
    <ul class="stone-links">
      {linkedStones.map((s) => (
        <li>
          <a href={`/${s.slug}`}>
            <Image src={s.image} alt="" widths={[160, 320]} sizes="160px" loading="lazy" />
            <span>{s.name}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<section class="band panel">
  <div class={`wrap two${SHOW_REVIEWS ? '' : ' one'}`}>
    <div>
      <h2 data-reveal>Questions</h2>
      <dl class="faqs">
        {a.faqs.map((f) => (
          <div>
            <dt>{f.q}</dt>
            <dd>{f.a}</dd>
          </div>
        ))}
      </dl>
    </div>
    {SHOW_REVIEWS && (
    <figure class="mini-review">
      <blockquote><p>{review.text}</p></blockquote>
      <figcaption><strong>{review.name}, {review.suburb}</strong> <span class="stars" role="img" aria-label={`${review.stars} out of 5 stars`}>{'★'.repeat(review.stars)}</span> {review.source}</figcaption>
    </figure>
    )}
  </div>
</section>

<section class="band hairline-top">
  <div class="wrap book-row">
    <div>
      <h2>Get a price</h2>
      <p>Send photos and the rough size of the area. <a class="tlink" href="/book-now#area">Work out your area</a></p>
    </div>
    <div class="cta-row">
      <a class="btn btn-primary" href={BOOKING_URL}>Book a quote</a>
      <a class="tlink" href="tel:1300220045">Call 1300 22 00 45</a>
    </div>
  </div>
</section>

<style>
  .hero-grid { display: grid; grid-template-columns: 1.1fr 1fr; gap: clamp(2rem, 5vw, 5rem); align-items: center; }
  .crumb { margin: 0 0 1rem; font-size: var(--step--1); }
  .crumb a { color: var(--muted); }
  .lede { font-size: var(--step-1); color: var(--lede); }
  .price { color: var(--muted); font-size: var(--step--1); margin-top: 1.25rem; }
  .price strong { color: var(--strong); }
  .hero-grid :global(.hero-img) { width: 100%; height: auto; aspect-ratio: 4 / 3; object-fit: cover; border-radius: 6px; box-shadow: 0 30px 60px -28px rgba(0,0,0,0.7); }
  .cta-row { display: flex; flex-wrap: wrap; align-items: center; gap: 0.9rem 1.6rem; }
  .one { grid-template-columns: 1fr; max-width: 760px; }
  .two { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2rem, 5vw, 5rem); align-items: start; }
  .risks { margin: 0; padding: 0; list-style: none; }
  .risks li { position: relative; padding: 0.75rem 0 0.75rem 1.6rem; border-top: 1px solid var(--hairline); }
  .risks li::before { content: ''; position: absolute; left: 0; top: 1.35em; width: 0.8rem; height: 2px; background: var(--teal); }
  .stone-links { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 1rem; }
  .stone-links a { display: flex; align-items: center; gap: 0.8rem; padding: 0.5rem 1.1rem 0.5rem 0.5rem; border: 1px solid var(--hairline); border-radius: 999px; color: var(--strong); text-decoration: none; transition: border-color 0.2s, background-color 0.2s; }
  .stone-links a:hover { border-color: var(--teal); background: rgba(33,158,188,0.1); }
  .stone-links :global(img) { width: 44px; height: 44px; border-radius: 50%; object-fit: cover; }
  .faqs { margin: 0; display: grid; gap: 1.4rem; }
  .faqs dt { font-weight: 700; color: var(--strong); margin-bottom: 0.3rem; }
  .faqs dd { margin: 0; }
  .mini-review { margin: 0; align-self: center; }
  .mini-review blockquote { margin: 0 0 0.8rem; font-family: var(--display); font-size-adjust: var(--display-adjust); font-size: var(--step-1); line-height: 1.35; color: var(--strong); }
  .mini-review blockquote p { margin: 0; }
  .mini-review figcaption { color: var(--muted); font-size: 0.95rem; display: flex; flex-wrap: wrap; gap: 0.3rem 0.7rem; align-items: center; }
  .mini-review strong { color: var(--strong); }
  .stars { color: var(--star); letter-spacing: 0.12em; }
  .book-row { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 1.5rem 3rem; }
  .book-row h2 { margin-bottom: 0.3em; }
  .book-row p { margin: 0; }
  @media (max-width: 860px) { .hero-grid, .two { grid-template-columns: 1fr; } }
</style>
